# AcousticIQ Environment Configuration Example
# Copy this file to .env and adjust variables for your local setup.

# Application Settings
ENVIRONMENT=development
APP_NAME=AcousticIQ
DEBUG=True
API_V1_PREFIX=/api

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage & Persistence
DATABASE_URL=sqlite:///./acousticiq.db
UPLOAD_DIR=./uploads
AUDIO_RETENTION_ENABLED=False
MAX_UPLOAD_SIZE_MB=25

# Machine Learning & Audio Pipeline (Configurable Dataset Paths)
MODEL_REGISTRY_DIR=./ml/checkpoints
EXPERIMENTS_DIR=./ml/experiments
DATASET_DIR=./ml/data
DATASET_RAW_DIR=./ml/data/raw/MIMII
DATASET_INTERIM_DIR=./ml/data/interim
DATASET_PROCESSED_DIR=./ml/data/processed
DATASET_METADATA_DIR=./ml/data/metadata
DEFAULT_SAMPLE_RATE=16000
N_MELS=64
N_FFT=1024
HOP_LENGTH=512
DECISION_THRESHOLD_PERCENTILE=95.0

